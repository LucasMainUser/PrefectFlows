# The structure/organization of the tables stored in the database (how data is arranged).
TABLES_SCHEMA = ""

# S3 bucket where all data files will be stored and retrieved from.
S3_BUCKET_NAME = ""

# If literal "TRUE" then SINAPI data will not be extracted. Otherwise, literal "FALSE" allow extraction 
IGNORE_SINAPI = ""

# If literal "TRUE" then CUB data will not be extracted. Otherwise, literal "FALSE" allow extraction
IGNORE_CUB = ""